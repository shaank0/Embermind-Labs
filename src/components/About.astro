---
const pillars = [
  { title: 'Consulting', desc: "Strategy, roadmaps, and honest guidance on where AI fits — and where it doesn't." },
  { title: 'Education', desc: 'Workshops and training that build real fluency for teams, leaders, and learners.' },
  { title: 'Implementation', desc: 'Hands-on builds — from prototypes to production AI woven into your workflow.' },
];
---
<section class="about" id="about">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">Who we are</h2>
      <span class="stamp">AI consulting &amp; education venture</span>
    </div>
    <div class="about-grid">
      <div class="reveal">
        <h3 class="about-h">We turn AI curiosity into <em>confident, working capability.</em></h3>
        <p>
          EmberMind Labs is an AI consulting and education venture. We sit at the
          intersection of strategy, teaching, and real implementation &mdash;
          helping teams move past the hype and put artificial intelligence to
          work where it actually matters.
        </p>
        <p>
          The spark of a good idea is only the beginning. Our job is to fan it
          into something durable: a clear strategy, a team that understands the
          tools, and systems that ship. We light the path from idea to impact.
        </p>
        <ul class="pillars">
          {pillars.map((p) => (
            <li>
              <span class="kicker">{p.title}</span>
              <p>{p.desc}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure class="about-art reveal">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/video/embermind-brain-poster.jpg"
          aria-label="EmberMind Labs logo — embers rising from a glowing brain"
        >
          <source src="/video/embermind-brain.webm" type="video/webm" />
          <source src="/video/embermind-brain.mp4" type="video/mp4" />
        </video>
        <figcaption>
          <span class="kicker kicker--onDark">EmberMind Labs</span>
          <span>Lighting the path from idea to impact</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: start;
    gap: 56px;
  }

  .about-h {
    max-width: 20ch;
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(30px, 3.8vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .about-h em {
    font-style: normal;
    color: var(--accent-ink);
  }

  .about-grid > div > p {
    max-width: 60ch;
    margin-bottom: 14px;
    font-size: 18px;
    color: var(--muted);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 32px;
  }

  .pillars li {
    padding-top: 14px;
    border-top: 2px solid var(--accent);
  }

  .pillars p {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .about-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--black);
    border-radius: 14px;
    box-shadow: 0 30px 60px rgba(10, 8, 7, 0.18);
  }

  /* Crop the tall logo video to the glowing brain */
  .about-art video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 10%;
    transform: scale(1.42);
  }

  .about-art figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 4px;
    padding: 18px 22px;
    background: linear-gradient(transparent, rgba(5, 4, 3, 0.92) 45%);
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--white);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .about-art { max-width: 480px; }
  }

  @media (max-width: 640px) {
    .pillars { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Respect reduced-motion: hold on the poster frame instead of looping.
  const video = document.querySelector<HTMLVideoElement>('.about-art video');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
