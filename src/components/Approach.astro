---
const steps = [
  {
    n: '01',
    title: 'Spark',
    desc: 'We listen first. Through discovery sessions we map your goals, constraints, and the ideas worth pursuing.',
  },
  {
    n: '02',
    title: 'Frame',
    desc: 'We shape a focused strategy — the right use cases, tools, and guardrails — and a plan your team believes in.',
  },
  {
    n: '03',
    title: 'Build',
    desc: 'We prototype and implement alongside you, teaching as we go so capability stays in-house.',
  },
  {
    n: '04',
    title: 'Ignite',
    desc: 'We launch, measure impact, and hand over the knowledge and systems to keep momentum burning.',
  },
];

const principles = [
  ['Listen', 'first: discovery before any recommendation'],
  ['Teach', 'as we build, so capability stays in-house'],
  ['Ship', 'real systems, not slideware'],
  ['Honest', 'about where AI fits — and where it doesn\'t'],
];
---
<section class="approach band" id="approach">
  <div class="wrap">
    <div class="approach-head">
      <div>
        <span class="kicker kicker--onDark">Our approach</span>
        <h2 class="approach-h h-em">A simple, proven path <em>from spark to impact.</em></h2>
      </div>
      <p>
        Every engagement follows the same four stages, whether it's a single
        workshop or a production build. You always know where you are, and
        what comes next.
      </p>
    </div>
    <ol class="cycle">
      {steps.map((s) => (
        <li>
          <span class="cycle-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
    <div class="approach-stats">
      {principles.map(([b, t]) => (
        <div><b>{b}</b><span>{t}</span></div>
      ))}
    </div>
    <a class="btn btn-ember" href="#contact">Start with a discovery call <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .approach::after {
    content: '';
    position: absolute;
    top: -120px;
    right: -200px;
    width: 700px;
    height: 300px;
    border: 2px solid rgba(255, 122, 26, 0.22);
    border-radius: 50%;
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .approach-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 48px;
    margin-bottom: 44px;
  }

  .approach-h {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .approach-head p {
    font-size: 18px;
    color: var(--soft-dark);
  }

  .cycle {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    border: 1px solid var(--line-dark);
    border-radius: var(--r);
  }

  .cycle li {
    position: relative;
    padding: 26px 22px;
    background: var(--ink-2);
    border-right: 1px solid var(--line-dark);
  }

  .cycle li:last-child { border-right: 0; }

  .cycle li::after {
    content: '→';
    position: absolute;
    top: 24px;
    right: -9px;
    z-index: 1;
    background: var(--ink-2);
    font-size: 14px;
    color: var(--accent);
  }

  .cycle li:last-child::after {
    content: '✦';
    right: 18px;
  }

  .cycle-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .cycle h3 {
    margin: 6px 0 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
  }

  .cycle p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-dark);
  }

  .approach-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 36px 0;
  }

  .approach-stats div {
    padding-top: 14px;
    border-top: 2px solid var(--accent);
  }

  .approach-stats b {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    line-height: 1;
    color: var(--white-pure);
  }

  .approach-stats span {
    font-size: 14px;
    color: var(--muted-dark);
  }

  @media (max-width: 1000px) {
    .approach-head {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .cycle { grid-template-columns: repeat(2, 1fr); }
    .cycle li:nth-child(2) { border-right: 0; }
    .cycle li:nth-child(-n + 2) { border-bottom: 1px solid var(--line-dark); }
    .cycle li:nth-child(2)::after { content: '↓'; right: 18px; }
    .approach-stats { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .cycle { grid-template-columns: 1fr; }

    .cycle li {
      border-right: 0;
      border-bottom: 1px solid var(--line-dark);
    }

    .cycle li:last-child { border-bottom: 0; }
    .cycle li::after { content: '↓'; right: 18px; }
  }
</style>
