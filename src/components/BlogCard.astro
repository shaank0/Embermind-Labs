---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  slug: string;
  basePath?: string;
}

const { title, description, pubDate, category, tags, slug, basePath = '/blog' } = Astro.props;
---
<a href={`${basePath}/${slug}`} class="content-card">
  <div class="content-card__meta">
    <span class="content-card__category">{category.toUpperCase()}</span>
    <span class="content-card__date">
      {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase()}
    </span>
  </div>
  <h3 class="content-card__title">{title}</h3>
  <p class="content-card__excerpt">{description}</p>
  {tags && tags.length > 0 && (
    <div class="content-card__tags">
      {tags.slice(0, 3).map(tag => <span class="content-card__tag">{tag}</span>)}
    </div>
  )}
  <span class="content-card__link">READ MORE &rarr;</span>
</a>

<style>
  .content-card {
    padding: var(--space-lg) var(--space-md);
    border: 1px solid var(--gray-dark);
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .content-card:hover {
    background: var(--dark);
    border-color: var(--accent-dim);
  }

  .content-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .content-card__category {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--black);
    background: var(--accent);
    padding: 0.2rem 0.5rem;
  }

  .content-card__date {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--gray);
  }

  .content-card__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
    letter-spacing: -0.01em;
  }

  .content-card__excerpt {
    font-size: 0.9rem;
    color: var(--gray-light);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    flex: 1;
  }

  .content-card__tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .content-card__tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--gray-light);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--gray-dark);
  }

  .content-card__link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent);
    transition: color 0.2s ease;
  }

  .content-card:hover .content-card__link {
    color: var(--accent-bright);
  }
</style>
