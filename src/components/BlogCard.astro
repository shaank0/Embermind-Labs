---
interface Props {
  index: number;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  slug: string;
  basePath?: string;
}

const { index, title, description, pubDate, category, tags, slug, basePath = '/blog' } = Astro.props;
const date = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<a href={`${basePath}/${slug}`} class="row">
  <span class="row-n">{String(index).padStart(2, '0')}</span>
  <span class="row-cat">{tags?.[0] ?? category}</span>
  <span class="row-body">
    <h3>{title}</h3>
    <span class="row-dek">{description}</span>
    <span class="row-meta"><b>EmberMind Labs</b> <time datetime={pubDate.toISOString()}>{date}</time></span>
  </span>
  <span class="row-go" aria-hidden="true">→</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 44px 150px 1fr 30px;
    align-items: start;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .row:hover h3 { color: var(--accent-ink); }

  .row:hover .row-go {
    color: var(--accent-ink);
    transform: translateX(4px);
  }

  .row-n {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }

  .row-cat {
    padding-top: 5px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .row-body {
    display: grid;
    gap: 4px;
  }

  .row h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .row-dek {
    font-size: 15.5px;
    color: var(--muted);
  }

  .row-meta {
    font-size: 13px;
    color: var(--muted);
  }

  .row-meta b {
    margin-right: 6px;
    color: var(--text);
  }

  .row-go {
    padding-top: 2px;
    font-size: 20px;
    color: var(--muted);
    transition: transform 0.15s;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 32px 1fr;
      gap: 6px 12px;
    }

    .row-cat,
    .row-body {
      grid-column: 2;
      padding-top: 0;
    }

    .row-go { display: none; }
  }
</style>
