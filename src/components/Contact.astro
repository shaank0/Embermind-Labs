---
import { site, FORMSPREE_ID } from '../config';

const endpoint = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : '';
---
<section class="contact band" id="contact">
  <div class="wrap">
    <div class="contact-inner">
      <div>
        <span class="kicker kicker--onDark">Start a conversation</span>
        <h2 class="contact-h h-em">Let's light <em>the path.</em></h2>
        <p>
          Exploring AI for your organization? Want to upskill your team, or build
          something real? Tell us where you're headed &mdash; we read every message.
        </p>
        <div class="contact-list">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span class="dot"> · </span>
            <a href={site.x} target="_blank" rel="noopener noreferrer">X / Twitter</a>
          </span>
        </div>
      </div>

      <form
        class="quote"
        id="contactForm"
        action={endpoint || undefined}
        method="POST"
        data-endpoint={endpoint}
        data-email={site.email}
      >
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Organization<input name="organization" autocomplete="organization" /></label>
        <label>Interested in
          <select name="interest" id="interest">
            <option value="Not sure yet">Not sure yet</option>
            <option value="AI Strategy & Consulting" data-key="consulting">AI Strategy &amp; Consulting</option>
            <option value="AI Education & Training" data-key="education">AI Education &amp; Training</option>
            <option value="Implementation & Builds" data-key="implementation">Implementation &amp; Builds</option>
            <option value="Automation & Processes">Automation &amp; Processes</option>
            <option value="Speaking / Workshops">Speaking / Workshops</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label class="full">Message<textarea name="message" rows="4" required placeholder="Tell us about your idea or goal..."></textarea></label>
        <!-- Honeypot: humans never see or fill this; Formspree drops submissions that do -->
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="New inquiry from embermindlabs.ai" />
        <button class="btn btn-ember full" type="submit">Send message <span aria-hidden="true">→</span></button>
        <p class="form-status full" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('.form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const interest = document.getElementById('interest') as HTMLSelectElement | null;

  // Service cards link here with data-interest; preselect the matching topic.
  document.querySelectorAll<HTMLElement>('[data-interest]').forEach((card) => {
    card.addEventListener('click', () => {
      const opt = interest?.querySelector<HTMLOptionElement>(`option[data-key="${card.dataset.interest}"]`);
      if (interest && opt) interest.value = opt.value;
    });
  });

  function setStatus(text: string, kind: 'ok' | 'error' | '') {
    if (!status) return;
    status.textContent = text;
    status.dataset.kind = kind;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !button) return;

    const data = new FormData(form);
    if (data.get('_gotcha')) return;

    const endpoint = form.dataset.endpoint;

    // No form backend configured yet: hand off to the visitor's email client.
    if (!endpoint) {
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Organization: ${data.get('organization') || '-'}`,
        `Interested in: ${data.get('interest')}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
      const subject = `Inquiry: ${data.get('interest')}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      setStatus('Opening your email app to send this message…', 'ok');
      return;
    }

    const label = button.innerHTML;
    button.disabled = true;
    button.textContent = 'Sending…';
    setStatus('', '');

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      form.reset();
      setStatus("Thanks — your message is on its way. We'll be in touch soon.", 'ok');
    } catch {
      setStatus(`Something went wrong sending that. Please try again, or email us at ${form.dataset.email}.`, 'error');
    } finally {
      button.disabled = false;
      button.innerHTML = label;
    }
  });
</script>

<style>
  .contact::before {
    content: '';
    position: absolute;
    bottom: -180px;
    left: -160px;
    width: 640px;
    height: 320px;
    border: 2px solid rgba(255, 122, 26, 0.25);
    border-radius: 50%;
    transform: rotate(-10deg);
    pointer-events: none;
  }

  .contact-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 56px;
  }

  .contact-h {
    margin: 12px 0 18px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact-h em { display: block; }

  .contact-inner > div > p {
    max-width: 46ch;
    font-size: 18px;
    color: var(--soft-dark);
  }

  .contact-list {
    display: grid;
    gap: 8px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted-dark);
  }

  .contact-list a {
    font-weight: 700;
    color: var(--white-pure);
  }

  .contact-list a:hover { color: var(--accent); }

  .quote {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding: 26px;
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    border-radius: 14px;
  }

  .quote label {
    display: grid;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  .quote .full { grid-column: 1 / -1; }

  .quote input,
  .quote select,
  .quote textarea {
    width: 100%;
    padding: 12px 14px;
    background: var(--ink);
    border: 1px solid var(--line-dark);
    border-radius: 8px;
    font: inherit;
    font-family: var(--font-primary);
    font-size: 16px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--white-pure);
  }

  .quote textarea {
    resize: vertical;
    min-height: 110px;
  }

  .quote input::placeholder,
  .quote textarea::placeholder { color: var(--gray); }

  .quote input:focus,
  .quote select:focus,
  .quote textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-status {
    min-height: 1.4em;
    font-size: 15px;
  }

  .form-status[data-kind='ok'] { color: var(--accent-2); }
  .form-status[data-kind='error'] { color: #ff9a7a; }

  @media (max-width: 900px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 520px) {
    .quote {
      grid-template-columns: 1fr;
      padding: 20px;
    }
  }
</style>
