---
const faqs = [
  {
    q: 'What does EmberMind Labs actually do?',
    a: 'Three connected things: AI strategy and consulting, AI education and training, and hands-on implementation. Some clients need one; most end up using all three, because a good strategy needs a team that understands the tools and systems that actually ship.',
  },
  {
    q: 'Do you just advise, or do you build things too?',
    a: 'We build. From rapid prototypes and proofs of concept to workflow automation and LLM and agent integration, we implement alongside your team and stay through deployment and enablement.',
  },
  {
    q: "We're not sure AI is right for us yet. Can you help?",
    a: "That's a great place to start. An AI readiness assessment and use-case mapping show where AI creates real leverage for you, and we'll be honest about where it doesn't.",
  },
  {
    q: 'Who is your training for?',
    a: 'Teams, leaders, and individual learners. We run hands-on workshops, practical prompting and AI-skills sessions, custom curriculum, and both cohort and 1:1 programs.',
  },
  {
    q: 'How does an engagement start?',
    a: 'With the Spark stage: discovery sessions where we listen, map your goals and constraints, and find the ideas worth pursuing. From there we frame a focused plan before anything gets built.',
  },
  {
    q: 'Will our team be able to keep things running after you leave?',
    a: "That's the point. We teach as we build so capability stays in-house, and in the Ignite stage we hand over the knowledge and systems to keep momentum going.",
  },
];
---
<section class="faq" id="faq">
  <div class="wrap">
    <div class="faq-grid">
      <div class="faq-side">
        <span class="kicker">Straight answers</span>
        <h2 class="faq-h">Questions we actually get</h2>
        <p>About what we do, how we work, and where to start.</p>
        <a class="btn btn-ink" href="#contact">Ask us anything <span aria-hidden="true">→</span></a>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--card);
    border-top: 1px solid var(--line);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 56px;
  }

  .faq-side {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .faq-h {
    margin: 10px 0 12px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .faq-side p {
    margin-bottom: 22px;
    color: var(--muted);
  }

  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list details:first-child { border-top: 1px solid var(--line); }

  .faq-list summary {
    position: relative;
    padding: 20px 40px 20px 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
  }

  .faq-list summary::-webkit-details-marker { display: none; }

  .faq-list summary::after {
    content: '+';
    position: absolute;
    top: 16px;
    right: 6px;
    font-size: 26px;
    font-weight: 400;
    color: var(--accent-ink);
  }

  .faq-list details[open] summary::after { content: '–'; }

  .faq-list details p {
    max-width: 64ch;
    padding: 0 0 22px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .faq-side { position: static; }
  }
</style>
