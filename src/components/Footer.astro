---
import { site } from '../config';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="foot-logo" aria-label="EmberMind Labs home">
          <span><span class="foot-ember">Ember</span><span class="foot-mind">Mind</span></span> <span class="foot-labs">Labs</span>
        </a>
        <p>AI consulting and education. Strategy, training, and hands-on implementation that turns AI potential into real results.</p>
        <p class="foot-promise">{site.tagline}</p>
      </div>
      <div class="foot-col">
        <h3>Services</h3>
        <ul>
          <li><a href="/#services">AI Strategy &amp; Consulting</a></li>
          <li><a href="/#services">AI Education &amp; Training</a></li>
          <li><a href="/#services">Implementation &amp; Builds</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Explore</h3>
        <ul>
          <li><a href="/#about">About</a></li>
          <li><a href="/#approach">Approach</a></li>
          <li><a href="/blog">Insights</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={site.x} target="_blank" rel="noopener noreferrer">X / Twitter</a></li>
          <li><a href="/#contact">Start a conversation →</a></li>
        </ul>
      </div>
    </div>
    <hr class="foot-rule" />
    <div class="foot-base">
      <span>&copy; {year} EmberMind Labs · All rights reserved</span>
      <span>From idea to <span class="accent">impact</span></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 64px 0 34px;
    background: var(--ink);
    color: var(--muted-dark);
    font-size: 15px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
  }

  .foot-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-bottom: 14px;
    font-size: 1.35rem;
  }

  .foot-ember {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.55rem;
    color: var(--accent);
  }

  .foot-mind {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--white-pure);
  }

  .foot-labs {
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--white);
  }

  .foot-brand p { max-width: 40ch; }

  .foot-promise {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .foot-col h3 {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white-pure);
  }

  .foot-col ul {
    display: grid;
    gap: 8px;
  }

  .foot-col a:hover { color: var(--white-pure); }

  .foot-rule {
    margin: 40px 0 20px;
    border: 0;
    border-top: 1px solid var(--line-dark);
  }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .foot-grid { grid-template-columns: 1fr; }
  }
</style>
