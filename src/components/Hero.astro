---
const practice = [
  { n: '03', name: 'Implementation & Builds', state: 'implement', href: '#services' },
  { n: '02', name: 'Education & Training', state: 'educate', href: '#services' },
  { n: '01', name: 'AI Strategy & Consulting', state: 'consult', href: '#services' },
];

const chips = [
  ['3', 'connected practices'],
  ['4', 'stage approach'],
  ['1:1', '& cohort programs'],
  ['Hands-on', 'from prototype to production'],
];
---
<section class="hero">
  <div class="wrap">
    <div class="hero-eyebrow">AI consulting &amp; education · Lighting the path from idea to impact</div>
    <div class="hero-cols">
      <div>
        <h1 class="hero-h1">
          <span>From the spark</span>
          <span>of an idea</span>
          <span class="hero-accent">to real-world impact.</span>
        </h1>
        <p class="hero-lede">
          We help organizations and people turn the spark of an AI idea into
          real-world impact &mdash; through clear-eyed consulting, practical
          education, and hands-on implementation.
          <strong>AI that actually ships.</strong>
        </p>
        <div class="hero-actions">
          <a class="btn btn-ember" href="#contact">Start a conversation <span aria-hidden="true">→</span></a>
          <a class="hero-alt" href="#services">Explore services</a>
        </div>
      </div>
      <div class="stack" aria-label="What EmberMind Labs does">
        <div class="stack-head"><span>EmberMind // practice</span><span>3 pillars</span></div>
        <ol>
          {practice.map((p) => (
            <li>
              <a href={p.href}>
                <span class="stack-n">{p.n}</span>
                <span class="stack-name">{p.name}</span>
                <span class="stack-state"><span class="pulse" aria-hidden="true"></span>{p.state}</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="stack-foot" aria-hidden="true">
          <span class="stack-prompt">&gt;</span>
          <span id="typewriter"></span><span class="stack-cursor">_</span>
        </div>
      </div>
    </div>
    <div class="hero-chips">
      {chips.map(([b, t]) => <span><b>{b}</b>{t}</span>)}
    </div>
  </div>
</section>

<script>
  const typewriterEl = document.getElementById('typewriter');
  const phrases = [
    'AI STRATEGY & CONSULTING',
    'PRACTICAL AI EDUCATION',
    'HANDS-ON IMPLEMENTATION',
    'FROM IDEA TO IMPACT',
    'AI THAT ACTUALLY SHIPS'
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function typewrite() {
    if (!typewriterEl) return;
    const current = phrases[phraseIndex];
    let delay = isDeleting ? 30 : 60;

    charIndex += isDeleting ? -1 : 1;
    typewriterEl.textContent = current.substring(0, charIndex);

    if (!isDeleting && charIndex === current.length) {
      delay = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      delay = 400;
    }

    setTimeout(typewrite, delay);
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (typewriterEl) typewriterEl.textContent = 'FROM IDEA TO IMPACT';
  } else {
    typewrite();
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 64px 0 40px;
    background: var(--ink);
    color: var(--white);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 85% 10%, rgba(255, 122, 26, 0.2), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 100% 32px;
  }

  .hero .wrap { position: relative; }

  .hero-eyebrow {
    margin-bottom: 26px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero-cols {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: end;
    gap: 56px;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(44px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .hero-h1 span { display: block; }

  .hero-accent {
    margin-top: 0.25em;
    font-size: 0.56em;
    letter-spacing: -0.02em;
    background: var(--flame);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    max-width: 58ch;
    margin-top: 26px;
    font-size: 19px;
    color: var(--soft-dark);
  }

  .hero-lede strong {
    display: block;
    margin-top: 10px;
    color: var(--white-pure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
  }

  .hero-alt {
    font-size: 15px;
    font-weight: 700;
    color: var(--white-pure);
    border-bottom: 1px solid var(--accent);
  }

  .hero-alt:hover { color: var(--accent); }

  /* Practice "stack" panel */
  .stack {
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    border-radius: 14px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45), 0 0 80px rgba(255, 122, 26, 0.06);
  }

  .stack-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line-dark);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  .stack li a {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 15px 18px;
    border-bottom: 1px solid var(--line-dark);
    transition: background 0.15s;
  }

  .stack li a:hover { background: var(--ink-3); }

  .stack-n { color: var(--muted-dark); }

  .stack-name {
    font-weight: 700;
    color: var(--white-pure);
  }

  .stack-state {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stack-foot {
    min-height: 46px;
    padding: 14px 18px;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
  }

  .stack-prompt {
    margin-right: 8px;
    color: var(--muted-dark);
  }

  .stack-cursor { animation: emberFlicker 0.8s step-end infinite; }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--line-dark);
  }

  .hero-chips span {
    padding: 6px 14px;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted-dark);
  }

  .hero-chips b {
    margin-right: 6px;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 480px) {
    .stack li a { grid-template-columns: 28px 1fr; }
    .stack-state { display: none; }
  }
</style>
