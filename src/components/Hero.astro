---
import logo from '../assets/embermind-logo.png';
import { Image } from 'astro:assets';
---
<section class="hero" id="hero">
  <div class="hero__grid-overlay"></div>
  <div class="hero__ember-lines"></div>
  <div class="hero__sparks" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__tag">
        <span class="hero__tag-line"></span>
        <span class="hero__tag-text">LIGHTING THE PATH FROM IDEA TO IMPACT</span>
      </div>
      <h1 class="hero__title">
        <span class="hero__title-ember">Ember</span><span class="hero__title-mind">Mind</span>
        <span class="hero__title-labs">Labs</span>
      </h1>
      <div class="hero__subtitle">
        <span class="hero__subtitle-bracket">[</span>
        <span class="hero__subtitle-text" id="typewriter"></span>
        <span class="hero__subtitle-cursor">_</span>
        <span class="hero__subtitle-bracket">]</span>
      </div>
      <p class="hero__lede">
        We help organizations and people turn the spark of an AI idea into
        real-world impact &mdash; through clear-eyed consulting, practical
        education, and hands-on implementation.
      </p>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">CONSULT</span>
          <span class="hero__stat-label">// STRATEGY</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-value">EDUCATE</span>
          <span class="hero__stat-label">// TRAINING</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-value">IMPLEMENT</span>
          <span class="hero__stat-label">// IMPACT</span>
        </div>
      </div>
      <div class="hero__actions">
        <a href="#services" class="btn btn--primary">EXPLORE SERVICES</a>
        <a href="#contact" class="btn btn--outline">START A CONVERSATION</a>
      </div>
    </div>
    <div class="hero__visual">
      <div class="hero__visual-glow"></div>
      <Image src={logo} alt="EmberMind Labs logo — an ember brain igniting a profile" class="hero__logo" widths={[400, 600, 800]} sizes="(max-width: 900px) 70vw, 460px" loading="eager" />
    </div>
  </div>
  <div class="hero__scroll-indicator">
    <span class="hero__scroll-text">SCROLL</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<script>
  const typewriterEl = document.getElementById('typewriter');
  const phrases = [
    'AI STRATEGY & CONSULTING',
    'PRACTICAL AI EDUCATION',
    'HANDS-ON IMPLEMENTATION',
    'FROM IDEA TO IMPACT',
    'AI THAT ACTUALLY SHIPS'
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let typeSpeed = 60;

  function typewrite() {
    if (!typewriterEl) return;
    const current = phrases[phraseIndex];

    if (isDeleting) {
      typewriterEl.textContent = current.substring(0, charIndex - 1);
      charIndex--;
      typeSpeed = 30;
    } else {
      typewriterEl.textContent = current.substring(0, charIndex + 1);
      charIndex++;
      typeSpeed = 60;
    }

    if (!isDeleting && charIndex === current.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      typeSpeed = 400;
    }

    setTimeout(typewrite, typeSpeed);
  }

  typewrite();

  // Subtle parallax on hero grid
  const heroGrid = document.querySelector('.hero__grid-overlay') as HTMLElement;
  if (heroGrid && window.matchMedia('(min-width: 768px)').matches) {
    window.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 10;
      const y = (e.clientY / window.innerHeight - 0.5) * 10;
      heroGrid.style.transform = `translate(${x}px, ${y}px)`;
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
    background: radial-gradient(ellipse 90% 70% at 70% 40%, rgba(255, 122, 26, 0.08), transparent 60%), var(--black-deep);
    overflow: hidden;
  }

  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 122, 26, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 122, 26, 0.035) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent 90%);
  }

  .hero__ember-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__ember-lines::before,
  .hero__ember-lines::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent), transparent);
    opacity: 0.12;
    animation: emberDrift 9s ease-in-out infinite;
  }

  .hero__ember-lines::before { top: 32%; }
  .hero__ember-lines::after { top: 68%; animation-delay: 4.5s; }

  .hero__sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__sparks span {
    position: absolute;
    bottom: 20%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent-bright);
    box-shadow: 0 0 8px var(--accent);
    opacity: 0;
    animation: sparkRise 6s ease-in infinite;
  }

  .hero__sparks span:nth-child(1) { left: 18%; animation-delay: 0s; }
  .hero__sparks span:nth-child(2) { left: 26%; animation-delay: 1.4s; }
  .hero__sparks span:nth-child(3) { left: 33%; animation-delay: 2.8s; }
  .hero__sparks span:nth-child(4) { left: 22%; animation-delay: 3.7s; }
  .hero__sparks span:nth-child(5) { left: 30%; animation-delay: 4.6s; }
  .hero__sparks span:nth-child(6) { left: 15%; animation-delay: 5.3s; }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__content {
    max-width: 640px;
  }

  .hero__tag {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero__tag-line {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero__tag-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .hero__title {
    font-weight: 900;
    line-height: 0.95;
    margin-bottom: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }

  .hero__title-ember {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    color: var(--accent);
    letter-spacing: 0.01em;
    text-shadow: 0 0 40px var(--accent-glow-strong);
  }

  .hero__title-mind {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.2rem, 8.2vw, 6rem);
    letter-spacing: -0.03em;
    color: var(--white-pure);
  }

  .hero__title-labs {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 7.5vw, 5.5rem);
    letter-spacing: 0.02em;
    color: var(--white);
    flex-basis: 100%;
  }

  .hero__subtitle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .hero__subtitle-bracket {
    color: var(--gray);
    font-weight: 700;
  }

  .hero__subtitle-cursor {
    animation: cursorBlink 0.8s step-end infinite;
  }

  .hero__lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--gray-light);
    max-width: 520px;
    margin-bottom: var(--space-lg);
  }

  .hero__stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--gray-dark);
    border-bottom: 1px solid var(--gray-dark);
  }

  .hero__stat-value {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: 0.05em;
  }

  .hero__stat-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--gray-light);
    letter-spacing: 0.15em;
    margin-top: 0.25rem;
  }

  .hero__stat-divider {
    width: 1px;
    height: 40px;
    background: var(--gray-dark);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Visual / logo */
  .hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__visual-glow {
    position: absolute;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow-strong), transparent 65%);
    filter: blur(20px);
    animation: emberFlicker 4s ease-in-out infinite;
  }

  .hero__logo {
    position: relative;
    width: 100%;
    max-width: 460px;
    height: auto;
    border-radius: 12px;
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    right: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
  }

  .hero__scroll-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    color: var(--gray-light);
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero__visual {
      order: -1;
      margin-bottom: var(--space-md);
    }

    .hero__logo {
      max-width: 280px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-lg) var(--space-sm);
    }

    .hero__stats {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .hero__stat-divider {
      width: 40px;
      height: 1px;
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__scroll-indicator {
      display: none;
    }
  }
</style>
