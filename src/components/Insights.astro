---
interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags?: string[];
    };
  }>;
}

const { posts } = Astro.props;
const [lead, ...rest] = posts;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const label = (p: Props['posts'][number]) => p.data.tags?.[0] ?? p.data.category;
---
<section class="insights" id="insights">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">Insights</h2>
      <a class="stamp" href="/blog">All insights →</a>
    </div>
    {lead ? (
      <div class="lead-grid">
        <a class="lead-story" href={`/blog/${lead.id}`}>
          <div class="art" aria-hidden="true">
            <svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice">
              <defs>
                <radialGradient id="emberGlow" cx="70%" cy="55%" r="55%">
                  <stop offset="0" stop-color="#ff7a1a" stop-opacity="0.55" />
                  <stop offset="0.5" stop-color="#e8350d" stop-opacity="0.18" />
                  <stop offset="1" stop-color="#0a0807" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="emberLine" x1="0" x2="1">
                  <stop offset="0" stop-color="#e8350d" />
                  <stop offset="0.5" stop-color="#ff7a1a" />
                  <stop offset="1" stop-color="#ffcf5c" />
                </linearGradient>
              </defs>
              <rect width="800" height="400" fill="#0a0807" />
              <rect width="800" height="400" fill="url(#emberGlow)" />
              <g stroke="#2e2420" stroke-width="1">
                {Array.from({ length: 12 }, (_, i) => <line x1="0" x2="800" y1={i * 34} y2={i * 34} />)}
              </g>
              <path d="M40 330 C 200 320, 300 260, 420 220 S 640 120, 760 70" fill="none" stroke="url(#emberLine)" stroke-width="4" stroke-linecap="round" />
              {[[120, 318], [260, 285], [420, 220], [560, 160], [700, 92]].map(([x, y], i) => (
                <circle cx={x} cy={y} r={i === 4 ? 9 : 6} fill={i === 4 ? '#ffcf5c' : '#ff7a1a'} />
              ))}
              <text x="40" y="60" fill="#9a8f88" font-family="JetBrains Mono, monospace" font-size="16" letter-spacing="3">IDEA → IMPACT</text>
            </svg>
          </div>
          <span class="kicker">Insight · {label(lead)}</span>
          <h3 class="lead-title">{lead.data.title}</h3>
          <p>{lead.data.description}</p>
          <div class="byline">
            <span class="avatar">EM</span>
            <span>EmberMind Labs</span>
            <span class="dot">•</span>
            <time datetime={lead.data.pubDate.toISOString()}>{fmt(lead.data.pubDate)}</time>
          </div>
        </a>
        <aside class="lead-stack">
          <div class="stack-label">Latest</div>
          {rest.map((p) => (
            <a class="lead-item" href={`/blog/${p.id}`}>
              <div class="meta-row"><span>{label(p)}</span><span>{fmt(p.data.pubDate)}</span></div>
              <h3>{p.data.title}</h3>
            </a>
          ))}
          <div class="lead-note">
            <p>
              Practical perspectives on applied AI &mdash; strategy, education, and
              the craft of turning ideas into impact. More on the way.
            </p>
            <a class="stamp" href="/blog">Browse all insights →</a>
          </div>
        </aside>
      </div>
    ) : (
      <p class="insights-empty">Insights are on the way. Check back soon.</p>
    )}
  </div>
</section>

<style>
  .lead-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
  }

  .lead-story {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lead-story .art {
    overflow: hidden;
    aspect-ratio: 16 / 8;
    margin-bottom: 6px;
    border-radius: var(--r);
    background: var(--ink);
  }

  .lead-story .art svg {
    width: 100%;
    height: 100%;
  }

  .lead-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lead-story:hover .lead-title { color: var(--accent-ink); }

  .lead-story > p {
    font-size: 17px;
    color: var(--muted);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--black);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  .lead-stack {
    padding-left: 32px;
    border-left: 1px solid var(--line);
  }

  .stack-label {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lead-item {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .lead-item:first-of-type { border-top: 1px solid var(--line); }

  .lead-item h3 {
    margin-top: 4px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.25;
  }

  .lead-item:hover h3 { color: var(--accent-ink); }

  .meta-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta-row span:first-child {
    font-weight: 700;
    color: var(--accent-ink);
  }

  .lead-note {
    padding: 18px 0;
  }

  .lead-note p {
    margin-bottom: 10px;
    color: var(--muted);
  }

  .insights-empty {
    padding: 40px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .lead-grid { grid-template-columns: 1fr; }

    .lead-stack {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
