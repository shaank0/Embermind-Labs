---
import { site } from '../config';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#services', label: 'Services' },
  { href: '/#approach', label: 'Approach' },
  { href: '/blog', label: 'Insights' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];
---
<div class="utility">
  <div class="wrap">
    <div class="u-left">
      <span>AI consulting &amp; education</span>
      <span class="dot">·</span>
      <span>{site.tagline}</span>
    </div>
    <div class="u-right">
      <span><span class="pulse" aria-hidden="true"></span>Now booking discovery calls</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap mast-row">
    <a href="/" class="brand" aria-label="EmberMind Labs home">
      <span class="brand-word">
        <span class="brand-spark" aria-hidden="true"></span>
        <span><span class="brand-ember">Ember</span><span class="brand-mind">Mind</span></span>
        <span class="brand-labs">Labs</span>
      </span>
      <span class="brand-sub">From idea to impact</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-ember mast-cta" href="/#contact">Start a conversation <span aria-hidden="true">→</span></a>
    <details class="mobmenu">
      <summary aria-label="Menu"><span></span></summary>
      <nav class="mobmenu-list" aria-label="Mobile">
        <a class="btn btn-ember" href="/#contact">Start a conversation →</a>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a link
  const menu = document.querySelector<HTMLDetailsElement>('.mobmenu');
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu.removeAttribute('open'));
  });
</script>

<style>
  .utility {
    background: var(--ink);
    color: var(--muted-dark);
    font-family: var(--font-mono);
    font-size: 12px;
    border-bottom: 1px solid var(--line-dark);
  }

  .utility .wrap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 9px;
    padding-bottom: 9px;
  }

  .u-left,
  .u-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .u-right a { color: var(--white); }
  .u-right a:hover { color: var(--accent); }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 8, 7, 0.94);
    backdrop-filter: blur(10px);
    color: var(--white);
    border-bottom: 1px solid var(--line-dark);
  }

  .mast-row {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .brand-word {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 1.3rem;
  }

  .brand-spark {
    width: 8px;
    height: 8px;
    align-self: center;
    margin-right: 0.1rem;
    border-radius: 50%;
    background: var(--flame);
    box-shadow: 0 0 10px var(--accent), 0 0 18px var(--accent-glow-strong);
    animation: emberFlicker 3s ease-in-out infinite;
  }

  .brand-ember {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--accent);
  }

  .brand-mind {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--white-pure);
    letter-spacing: -0.01em;
  }

  .brand-labs {
    font-family: var(--font-display);
    font-weight: 300;
  }

  .brand-sub {
    max-width: 110px;
    padding-left: 14px;
    border-left: 1px solid var(--line-dark);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  .nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 15px;
    font-weight: 600;
  }

  .nav a {
    padding: 6px 0;
    color: var(--soft-dark);
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    color: var(--white-pure);
    border-color: var(--accent);
  }

  .mast-cta {
    padding: 11px 20px;
    font-size: 15px;
  }

  .mobmenu {
    display: none;
    position: relative;
    margin-left: auto;
  }

  .mobmenu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--line-dark);
    border-radius: 8px;
  }

  .mobmenu summary::-webkit-details-marker { display: none; }

  .mobmenu summary span,
  .mobmenu summary span::before,
  .mobmenu summary span::after {
    content: '';
    display: block;
    position: relative;
    width: 20px;
    height: 2px;
    background: var(--white);
  }

  .mobmenu summary span::before { position: absolute; top: -6px; }
  .mobmenu summary span::after { position: absolute; top: 6px; }

  .mobmenu-list {
    position: absolute;
    top: 54px;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 260px;
    padding: 14px;
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    border-radius: var(--r);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .mobmenu-list a:not(.btn) {
    padding: 10px 8px;
    border-bottom: 1px solid var(--line-dark);
  }

  .mobmenu-list .btn { margin-bottom: 8px; }

  @media (max-width: 1080px) {
    .nav { display: none; }
    .mast-cta { margin-left: auto; }
    .mobmenu { display: block; margin-left: 0; }
  }

  @media (max-width: 760px) {
    .u-left { display: none; }
    .utility .wrap { justify-content: center; }
  }

  @media (max-width: 640px) {
    .mast-cta,
    .brand-sub { display: none; }
    .mobmenu { margin-left: auto; }
  }
</style>
