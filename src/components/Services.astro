---
const services = [
  {
    kicker: 'Strategy',
    title: 'AI Strategy & Consulting',
    desc: 'Cut through the noise. We assess where you are, find where AI creates real leverage, and build a roadmap you can actually execute.',
    items: ['AI Readiness Assessment', 'Opportunity & Use-Case Mapping', 'Roadmaps & Governance', 'Tooling & Vendor Selection'],
    interest: 'consulting',
  },
  {
    kicker: 'Education',
    title: 'AI Education & Training',
    desc: 'Build lasting fluency. Hands-on workshops and programs that take teams, leaders, and learners from cautious to capable.',
    items: ['Team & Leadership Workshops', 'Prompting & Practical AI Skills', 'Custom Curriculum Design', 'Cohort & 1:1 Programs'],
    interest: 'education',
    feature: true,
  },
  {
    kicker: 'Build',
    title: 'Implementation & Builds',
    desc: 'From idea to impact. We prototype, integrate, and ship AI into your real workflows — with your team beside us the whole way.',
    items: ['Rapid Prototyping & POCs', 'Workflow & Process Automation', 'LLM & Agent Integration', 'Deployment & Enablement'],
    interest: 'implementation',
  },
];
---
<section class="services" id="services">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">What we do</h2>
      <span class="stamp">3 practices · one partner</span>
    </div>
    <p class="section-intro">
      Strategy, teaching, and real implementation, under one roof. Start with
      whichever you need most; the three are built to work together.
    </p>
    <div class="svc-grid">
      {services.map((s) => (
        <a class:list={['svc', 'reveal', { 'svc-feature': s.feature }]} href={`#contact`} data-interest={s.interest}>
          <span class="kicker">{s.kicker}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <ul>
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
          <span class="svc-more">Talk to us about this →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--card);
    border-top: 1px solid var(--line);
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s, opacity 0.7s ease;
  }

  .svc:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(10, 8, 7, 0.08);
  }

  .svc h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .svc p {
    font-size: 15.5px;
    color: var(--muted);
  }

  .svc ul {
    display: grid;
    gap: 6px;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .svc li {
    position: relative;
    padding-left: 18px;
    font-size: 14.5px;
  }

  .svc li::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }

  .svc-more {
    margin-top: auto;
    padding-top: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-ink);
  }

  .svc-feature {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  .svc-feature p { color: var(--muted-dark); }
  .svc-feature ul { border-color: var(--line-dark); }
  .svc-feature .kicker,
  .svc-feature .svc-more { color: var(--accent); }

  @media (max-width: 1000px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
