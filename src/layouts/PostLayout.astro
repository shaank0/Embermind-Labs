---
import Layout from './Layout.astro';
import CtaStrip from '../components/CtaStrip.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    category?: string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;
const date = frontmatter.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Layout title={`${frontmatter.title} // EmberMind Labs`} description={frontmatter.description}>
  <section class="post-hero band">
    <div class="wrap">
      <a href="/blog" class="post-back">← All insights</a>
      {frontmatter.category && <span class="kicker kicker--onDark">{frontmatter.category}</span>}
      <h1 class="post-title">{frontmatter.title}</h1>
      <p class="post-dek">{frontmatter.description}</p>
      <div class="post-meta">
        <span class="avatar">EM</span>
        <span>EmberMind Labs</span>
        <span class="dot">•</span>
        <time datetime={frontmatter.pubDate.toISOString()}>{date}</time>
      </div>
    </div>
  </section>
  <article class="post">
    <div class="wrap post-grid">
      <div class="prose">
        <slot />
      </div>
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <aside class="post-tags">
          <div class="kicker">Topics</div>
          <div>{frontmatter.tags.map((tag) => <span>{tag}</span>)}</div>
        </aside>
      )}
    </div>
  </article>
  <CtaStrip />
</Layout>

<style>
  .post-hero { padding: 48px 0 56px; }

  .post-back {
    display: inline-block;
    margin-bottom: 26px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  .post-back:hover { color: var(--accent); }

  .post-hero .kicker { display: block; }

  .post-title {
    max-width: 22ch;
    margin: 12px 0 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 5.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .post-dek {
    max-width: 60ch;
    font-size: 19px;
    color: var(--soft-dark);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    font-size: 14px;
    color: var(--muted-dark);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--black);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  .post { padding: 48px 0 56px; }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 720px) 1fr;
    gap: 56px;
  }

  .post-tags {
    position: sticky;
    top: 100px;
    align-self: start;
    padding-top: 14px;
    border-top: 3px solid var(--ink);
  }

  .post-tags > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .post-tags span {
    padding: 6px 12px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .post-grid { grid-template-columns: 1fr; }
    .post-tags { position: static; }
  }
</style>
