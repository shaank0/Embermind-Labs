---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Insights // EmberMind Labs" description="Practical perspectives on applied AI — strategy, education, and turning ideas into impact, from EmberMind Labs.">
  <section class="page-hero band">
    <div class="wrap">
      <span class="kicker kicker--onDark">Insights</span>
      <h1 class="page-h h-em">Practical perspectives on <em>applied AI.</em></h1>
      <p>Strategy, education, and the craft of turning ideas into impact.</p>
    </div>
  </section>
  <section class="feed">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">All insights</h2>
        <span class="stamp">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      </div>
      {posts.length > 0 ? (
        <div class="rows">
          {posts.map((post, i) => (
            <BlogCard
              index={i + 1}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              tags={post.data.tags}
              slug={post.id}
            />
          ))}
        </div>
      ) : (
        <p class="feed-empty">No insights published yet. Check back soon.</p>
      )}
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding: 56px 0; }

  .page-h {
    max-width: 18ch;
    margin: 12px 0 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .page-hero p {
    font-size: 19px;
    color: var(--soft-dark);
  }

  .feed { min-height: 40vh; }

  .rows { border-top: 1px solid var(--line); }

  .feed-empty {
    padding: 40px 0;
    font-family: var(--font-mono);
    color: var(--muted);
  }
</style>
