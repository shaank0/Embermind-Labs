---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Approach from '../components/Approach.astro';
import Insights from '../components/Insights.astro';
import CtaStrip from '../components/CtaStrip.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<Layout>
  <Hero />
  <Ticker />
  <About />
  <Services />
  <Approach />
  <Insights posts={latestPosts} />
  <CtaStrip />
  <Faq />
  <Contact />
</Layout>
